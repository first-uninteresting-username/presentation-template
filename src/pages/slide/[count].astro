---
import { getCollection, render } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import TextSlide from "../../components/TextSlide.astro";
import ImageSlide from "../../components/ImageSlide.astro";
import ImageRowSlide from "../../components/ImageRowSlide.astro";
import TextCreditsSlide from "../../components/TextCreditsSlide.astro";
import SlideBase from "../../components/templates/SlideBase.astro";

export async function getStaticPaths() {
  const slides = await getCollection("slides");
  return slides.map((slide) => ({
    params: { count: String(slide.data.count) },
    props: { slide },
  }));
}

const { slide } = Astro.props;
const { Content } = await render(slide);

import { theme } from "../../theme.ts";
---

<Layout>
  {slide.data.type === "text" && (
    <TextSlide title={slide.data.title} count={slide.data.count} {...theme}>
      <Content />
    </TextSlide>
  )}
  {slide.data.type === "image" && (
    <ImageSlide
      title={slide.data.title}
      count={slide.data.count}
      image={slide.data.image}
      alt={slide.data.alt}
      caption={slide.data.caption}
      rightImage={slide.data.rightImage}
      rightAlt={slide.data.rightAlt}
      rightCaption={slide.data.rightCaption}
      {...theme}
    />
  )}
  {slide.data.type === "image-row" && (
    <ImageRowSlide
      title={slide.data.title}
      count={slide.data.count}
      image={slide.data.image}
      alt={slide.data.alt}
      caption={slide.data.caption}
      bottomImage={slide.data.bottomImage}
      bottomAlt={slide.data.bottomAlt}
      bottomCaption={slide.data.bottomCaption}
      {...theme}
    >
      <Content />
    </ImageRowSlide>
  )}
  {slide.data.type === "text-credits" && (
    <TextCreditsSlide
      title={slide.data.title}
      count={slide.data.count}
      {...theme}
      credits={slide.data.credits}
    >
      <Content />
    </TextCreditsSlide>
  )}
  {slide.data.type === "empty" && (
    <SlideBase title={slide.data.title} count={slide.data.count} {...theme} />
  )}
</Layout>
