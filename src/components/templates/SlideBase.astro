---
interface Props {
  title: string;
  count: number;
  surfaceColor: string;
  onSurfaceColor: string;
  primaryColor: string;
  onPrimaryColor: string;
}
const {
  title,
  count,
  surfaceColor,
  onSurfaceColor,
  primaryColor,
  onPrimaryColor,
} = Astro.props;

import ButtonBase from "./ButtonBase.astro";

import { Icon } from "astro-icon/components";

const prevHidden = count === 1;

import { getCollection } from "astro:content";
const slides = await getCollection("slides");
const total = slides.length;

const nextHidden = count === total;

// Astro doesn't prefix hand-written links with `base`, so do it here.
// BASE_URL may or may not end in "/", so strip it to avoid "//slide".
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
---

<body
  class="m-0 w-full flex flex-col h-screen bg-(--bg) text-(--fg)"
  style={`--bg: ${surfaceColor}; --fg: ${onSurfaceColor}`}
>
  <div
    class="bg-(--bg) text-(--fg)"
    style={`--bg: ${surfaceColor}; --fg: ${onSurfaceColor}`}
  >
    <h1 class="p-6 text-center text-3xl font-bold">
      {count}. {title}
    </h1>
  </div>
  <slot />
  <footer
    class="bg-(--bg) text-(--fg) w-full flex justify-center gap-4 p-4"
    style={`--bg: ${surfaceColor}; --fg: ${onSurfaceColor}`}
  >
    <ButtonBase
      color={primaryColor}
      textColor={onPrimaryColor}
      href={`${base}/slide/${count - 1}`}
      hidden={prevHidden}
      shortcut="Backspace"
    >
      <Icon name="lucide:arrow-left" />
      Slide {count - 1}
    </ButtonBase>
    <ButtonBase
      color={primaryColor}
      textColor={onPrimaryColor}
      href={`${base}/slide/${count + 1}`}
      hidden={nextHidden}
      shortcut={" " /*This is correct*/}
    >
      Slide {count + 1}
      <Icon name="lucide:arrow-right" />
    </ButtonBase>
  </footer>
</body>
