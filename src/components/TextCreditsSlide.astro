---
interface Props {
  title: string;
  count: number;
  surfaceColor: string;
  onSurfaceColor: string;
  primaryColor: string;
  onPrimaryColor: string;
  credits: string;
}

const {
  title,
  count,
  surfaceColor,
  onSurfaceColor,
  primaryColor,
  onPrimaryColor,
  credits,
} = Astro.props;

import SlideBase from "./templates/SlideBase.astro";
import FitText from "./templates/FitText.astro";
---

<SlideBase
  title={title}
  count={count}
  surfaceColor={surfaceColor}
  onSurfaceColor={onSurfaceColor}
  primaryColor={primaryColor}
  onPrimaryColor={onPrimaryColor}
>
  <div class="flex flex-col p-6 w-full grow min-h-0">
    <figure class="flex grow min-h-0 flex-col">
      <FitText>
        <slot />
      </FitText>
      <figcaption class="text-center text-2xl whitespace-pre-line">
        {credits}
      </figcaption>
    </figure>
  </div>
</SlideBase>
