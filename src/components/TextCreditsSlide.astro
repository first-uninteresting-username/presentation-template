---
interface Props {
  title: string;
  count: number;
  surfaceColor: string;
  onSurfaceColor: string;
  primaryColor: string;
  onPrimaryColor: string;
  credits: string;
}

const {
  title,
  count,
  surfaceColor,
  onSurfaceColor,
  primaryColor,
  onPrimaryColor,
  credits,
} = Astro.props;

import SlideBase from "./templates/SlideBase.astro";
---

<SlideBase
  title={title}
  count={count}
  surfaceColor={surfaceColor}
  onSurfaceColor={onSurfaceColor}
  primaryColor={primaryColor}
  onPrimaryColor={onPrimaryColor}
>
  <div class="flex flex-col p-6 items-center w-full grow min-h-0 text-3xl @container">
    <figure class="text-[clamp(1.5rem,10cqw,8rem)] flex grow min-h-0 flex-col">
      <div class="my-auto">
        <slot />
      </div>
      <figcaption class="text-center text-2xl">{credits}</figcaption>
    </figure>
  </div>
</SlideBase>
