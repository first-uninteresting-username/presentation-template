---
interface Props {
  title: string;
  count: number;
  bgColor: string;
  buttonColor: string;
}
const { title, count, bgColor, buttonColor } = Astro.props;

import ButtonBase from "./ButtonBase.astro";

import { Icon } from "astro-icon/components";

const prevHidden = count === 1;
---

<body class="m-0 w-full h-full bg-(--bg)" style={`--bg: ${bgColor}`}>
  <slot />
  <div class="bg-(--bg)" style={`--bg: ${bgColor}`}>
    <h1 class="p-6 text-center text-2xl font-bold">
      {count}. {title}
    </h1>
  </div>
</body>
<footer
  class="bg-(--bg) fixed left-0 bottom-0 w-full flex justify-center gap-4 p-4"
  style={`--bg: ${bgColor}`}
>
  <ButtonBase
    color={buttonColor}
    href={`/slide/${count - 1}`}
    hidden={prevHidden}
  >
    <Icon name="lucide:arrow-left" />
    Slide {count - 1}
  </ButtonBase>
  <ButtonBase color={buttonColor} href={`/slide/${count + 1}`}>
    Slide {count + 1}
    <Icon name="lucide:arrow-right" />
  </ButtonBase>
</footer>
