---
interface Props {
  title: string;
  count: number;
  surfaceColor: string;
  onSurfaceColor: string;
  primaryColor: string;
  onPrimaryColor: string;
  image: ImageMetadata;
  alt: string;
  caption?: string;
  rightImage?: ImageMetadata;
  rightAlt?: string;
  rightCaption?: string;
}
const {
  title,
  count,
  surfaceColor,
  onSurfaceColor,
  primaryColor,
  onPrimaryColor,
  image,
  alt,
  caption,
  rightImage,
  rightAlt,
  rightCaption,
} = Astro.props;

import SlideBase from "./templates/SlideBase.astro";

import { Image } from "astro:assets";
---

<SlideBase
  {title}
  {count}
  {surfaceColor}
  {onSurfaceColor}
  {primaryColor}
  {onPrimaryColor}
>
  <figure class="flex w-full grow min-h-0 flex-col items-center gap-4">
    <div class="flex w-full grow min-h-0 flex-row justify-center">
      <figure class="flex flex-col items-center gap-4 p-6">
        <Image src={image} alt={alt} class="object-contain min-h-0" />
        {caption && rightCaption && (
          <figcaption class="text-center text-2xl whitespace-pre-line">
            {caption}
          </figcaption>
        )}
      </figure>
      {rightImage && rightAlt && (
        <figure class="flex flex-col items-center gap-4 p-6">
          <Image
            src={rightImage}
            alt={rightAlt}
            class="object-contain min-h-0"
          />
          {caption && rightCaption && (
            <figcaption class="text-center text-2xl whitespace-pre-line">
              {rightCaption}
            </figcaption>
          )}
        </figure>
      )}
    </div>
    {caption && !rightCaption && (
      <figcaption class="text-center text-2xl whitespace-pre-line">
        {caption}
      </figcaption>
    )}
  </figure>
</SlideBase>
